  {lv:16, stage:"fill", q:"I had the mechanic ___ my car yesterday.", c:["check", "to check", "checking", "checked"], a:0, kw:"使役have", em:"🔧", yaku:"わたしは昨日、整備士に車を点検してもらいました。", rel:[], exp:"文脈と文法から判断する。"},
