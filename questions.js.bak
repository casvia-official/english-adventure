  {lv:10, stage:"grammar", q:"My mother ___ dinner.", c:["cooks","cook","cooking","is"], a:0, kw:"三単現", em:"🍳", yaku:"母は夕食を作ります。", rel:[], exp:"mother は3人称単数なので cooks。"},
