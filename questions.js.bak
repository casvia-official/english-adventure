  {lv:10, stage:"grammar", q:"___ old are you? — I'm twelve.", c:["How","What","Who","When"], a:0, kw:"疑問詞", em:"🎂", yaku:"何歳ですか？—12歳です。", rel:[], exp:"年齢は How old。"},
