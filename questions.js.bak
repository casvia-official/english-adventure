  {lv:16, stage:"fill", q:"By the time I arrived, the meeting ___ already started.", c:["had", "has", "was", "did"], a:0, kw:"過去完了", em:"🕐", yaku:"わたしが着いたときには、会議はすでに始まっていました。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"She had never seen snow before she ___ to Canada.", c:["moved", "moves", "moving", "move"], a:0, kw:"過去完了", em:"❄️", yaku:"彼女はカナダに引っ越す前、雪を見たことがありませんでした。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"___ it rains tomorrow, we will go hiking.", c:["Unless", "If", "Although", "Because"], a:0, kw:"unless", em:"🥾", yaku:"もし明日雨が降らなければ、ハイキングに行きます。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"You should take an umbrella ___ it rains.", c:["in case", "unless", "although", "despite"], a:0, kw:"in case", em:"☔", yaku:"雨が降る場合に備えて傘を持っていくべきです。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"___ how hard he tried, he could not solve the puzzle.", c:["No matter", "Even if", "Unless", "Although"], a:0, kw:"no matter how", em:"🧩", yaku:"どんなに一生けんめい頑張っても、彼はパズルを解けませんでした。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"This area produces no more rice ___ that one.", c:["than", "as", "that", "of"], a:0, kw:"no more...than", em:"🌾", yaku:"この地域はあの地域より多く米を生産しているわけではありません。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"It is not so much talent ___ effort that leads to success.", c:["as", "than", "but", "that"], a:0, kw:"not so much A as B", em:"💪", yaku:"成功をもたらすのは才能というよりむしろ努力です。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"It was my brother ___ broke the window.", c:["that", "who is", "which", "what"], a:0, kw:"強調構文", em:"🪟", yaku:"窓を割ったのはわたしの弟でした。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"What surprised me most ___ his honesty.", c:["was", "were", "is", "are"], a:0, kw:"名詞節主語", em:"😲", yaku:"わたしを最も驚かせたのは彼の正直さでした。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"This is the town ___ I was born.", c:["where", "which", "that", "who"], a:0, kw:"関係副詞where", em:"🏘️", yaku:"ここはわたしが生まれた町です。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"I remember the day ___ we first met.", c:["when", "where", "which", "who"], a:0, kw:"関係副詞when", em:"📅", yaku:"わたしたちが初めて出会った日を覚えています。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"That is the reason ___ she left early.", c:["why", "where", "when", "which"], a:0, kw:"関係副詞why", em:"❓", yaku:"それが彼女が早く帰った理由です。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"You must have ___ hard to pass such a difficult exam.", c:["studied", "study", "studying", "studies"], a:0, kw:"must have done", em:"📖", yaku:"そんな難しい試験に合格するなんて、一生けんめい勉強したにちがいありません。", rel:[], exp:"文脈と文法から判断する。"},
