  {lv:10, stage:"talk", q:"What day is it today? — ___", c:["It's Monday.","It's three.","It's sunny.","Yes, I do."], a:0, kw:"曜日", em:"📅", yaku:"「今日は何曜日？」「月曜日です。」", rel:[], exp:"曜日は It's 〜day.。"},
