  {lv:6, stage:"sentence", q:"「わたしは 医者では ない」= I am ___ a doctor.", c:["not", "no", "don't", "isn't"], a:0, kw:"否定", em:"🚫", rel:[], exp:"be動詞の否定は am not。"},
