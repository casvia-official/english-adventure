  {lv:10, stage:"grammar", q:"___ the door, please.", c:["Open","Opens","Opening","To open"], a:0, kw:"命令文", em:"🚪", yaku:"ドアを開けてください。", rel:[], exp:"命令文は動詞で始める。"},
