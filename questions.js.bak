  {lv:11, stage:"grammar", q:"I went to the park ___ my friends.", c:["with", "of", "to", "at"], a:0, kw:"前置詞", em:"🌳", rel:[], exp:"「〜と一緒に」は with。"},
  {lv:11, stage:"grammar", q:"She ___ TV last night.", c:["watched", "watch", "watches", "watching"], a:0, kw:"過去形", em:"📺", rel:[], exp:"last night(過去)なので watched。"},
  {lv:11, stage:"grammar", q:"There ___ some books on the desk.", c:["are", "is", "am", "be"], a:0, kw:"There are", em:"📚", rel:[], exp:"books(複数)なので There are。"},
  {lv:11, stage:"vocab", q:"「昨日」は 英語で どれ？", c:["yesterday", "tomorrow", "today", "morning"], a:0, kw:"yesterday", em:"📆", rel:["today", "tomorrow"], exp:"昨日は yesterday。"},
  {lv:11, stage:"grammar", q:"He is taller ___ me.", c:["than", "as", "then", "of"], a:0, kw:"比較級", em:"📏", rel:[], exp:"比較級 -er のあとは than。"},
  {lv:11, stage:"vocab", q:"borrow の 意味は？", c:["借りる", "貸す", "買う", "売る"], a:0, kw:"borrow", em:"📖", rel:["lend"], exp:"borrow は 借りる。貸すは lend。"},
  {lv:11, stage:"grammar", q:"I was ___ TV when he came.", c:["watching", "watch", "watched", "watches"], a:0, kw:"過去進行形", em:"📺", rel:[], exp:"was + -ing で過去進行形。"},
  {lv:11, stage:"grammar", q:"Must I go now? — No, you ___.", c:["don't have to", "must not", "must", "aren't"], a:0, kw:"must", em:"⏰", rel:[], exp:"「〜しなくてよい」は don't have to。"},
  {lv:11, stage:"vocab", q:"invite の 意味は？", c:["招待する", "訪ねる", "注文する", "到着する"], a:0, kw:"invite", em:"✉️", rel:["visit"], exp:"invite は 招待する。"},
  {lv:11, stage:"grammar", q:"What ___ you do yesterday?", c:["did", "do", "does", "are"], a:0, kw:"過去疑問", em:"❓", rel:[], exp:"yesterday(過去)の疑問文は did。"},

