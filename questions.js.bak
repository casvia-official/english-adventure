  {lv:10, stage:"talk", q:"What's this? — ___", c:["It's a camera.","I'm fine.","Yes, it is.","At school."], a:0, kw:"これは何", em:"📷", yaku:"「これは何？」「カメラです。」", rel:[], exp:"It's a 〜. で答える。"},
  {lv:10, stage:"talk", q:"How many pens do you have? — ___", c:["I have five.","It's five.","Yes, I do.","At five."], a:0, kw:"数", em:"🖊️", yaku:"「ペンを何本持ってる？」「5本です。」", rel:[], exp:"数を答える。"},
  {lv:10, stage:"talk", q:"Happy birthday! — ___", c:["Thank you!","You're welcome.","I'm sorry.","See you."], a:0, kw:"お祝い", em:"🎂", yaku:"「お誕生日おめでとう！」「ありがとう！」", rel:[], exp:"お祝いには Thank you!。"},
  {lv:10, stage:"talk", q:"See you tomorrow. — ___", c:["See you!","Thank you.","I'm fine.","It's mine."], a:0, kw:"別れ", em:"👋", yaku:"「また明日。」「またね！」", rel:[], exp:"別れのあいさつを返す。"},
  {lv:10, stage:"talk", q:"Thank you very much. — ___", c:["You're welcome.","Here you are.","I'm sorry.","Me, too."], a:0, kw:"お礼", em:"🙏", yaku:"「どうもありがとう。」「どういたしまして。」", rel:[], exp:"お礼には You're welcome.。"},
