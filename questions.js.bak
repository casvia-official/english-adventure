  {lv:6, stage:"sentence", q:"「ドアを 開けて」= ___ the door.", c:["Open", "Opens", "Opening", "To open"], a:0, kw:"命令文", em:"🚪", rel:[], exp:"命令文は動詞で始める。"},
  {lv:6, stage:"sentence", q:"「わたしは 走っている」= I am ___.", c:["running", "run", "runs", "to run"], a:0, kw:"現在進行形", em:"🏃", rel:[], exp:"am+動詞ing で「〜している」。"},
  {lv:6, stage:"sentence", q:"「わたしの 本」= ___ book", c:["my", "I", "me", "mine"], a:0, kw:"my", em:"📗", rel:[], exp:"「わたしの」は my。"},
  {lv:6, stage:"sentence", q:"「机の上に ねこが いる」= There ___ a cat on the desk.", c:["is", "are", "am", "be"], a:0, kw:"There is", em:"🐱", rel:[], exp:"単数なので There is。"},
  {lv:6, stage:"sentence", q:"「サッカーを しよう」= ___ play soccer.", c:["Let's", "Let", "We's", "Do"], a:0, kw:"Let's", em:"⚽", rel:[], exp:"「〜しよう」は Let's+動詞。"},
  {lv:6, stage:"sentence", q:"「わたしは 学校へ 行く」= I ___ to school.", c:["go", "goes", "going", "am go"], a:0, kw:"go to", em:"🏫", rel:[], exp:"主語 I なので go。行き先は to。"},
  {lv:6, stage:"sentence", q:"「彼女は ケンが すき」= She ___ Ken.", c:["likes", "like", "is", "liking"], a:0, kw:"三単現", em:"💕", rel:[], exp:"She なので likes。"},

