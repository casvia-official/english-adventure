  {lv:6, stage:"sentence", q:"「わたしは 納豆が すきではない」= I ___ like natto.", c:["don't", "not", "isn't", "doesn't"], a:0, kw:"一般動詞の否定", em:"🚫", rel:[], exp:"一般動詞の否定は don't+動詞。"},
  {lv:6, stage:"sentence", q:"「あなたは 犬が すき？」= ___ you like dogs?", c:["Do", "Are", "Does", "Is"], a:0, kw:"一般動詞の疑問", em:"❔", rel:[], exp:"一般動詞の疑問は Do you〜?。"},
  {lv:6, stage:"sentence", q:"「彼は テニスを する」= He ___ tennis.", c:["plays", "play", "playing", "are"], a:0, kw:"三単現", em:"🎾", rel:[], exp:"He など3人称単数は plays。"},
