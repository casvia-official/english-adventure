  {lv:16, stage:"fill", q:"He could have ___ the train if he had hurried.", c:["caught", "catch", "catching", "catches"], a:0, kw:"could have done", em:"🚄", yaku:"急いでいれば電車に間に合ったかもしれません。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"Being ___ from a small village, she was surprised by the big city.", c:["raised", "raise", "raising", "raises"], a:0, kw:"分詞構文(受け身)", em:"🏙️", yaku:"小さな村で育ったので、彼女は大都市に驚きました。", rel:[], exp:"文脈と文法から判断する。"},
