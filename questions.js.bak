  {lv:14, stage:"dialog", q:"A: I noticed you've been practicing the piano a lot.\nB: ( )", c:["Yes, I have a recital coming up.", "It's mine.", "Yes, I can.", "At home."], a:0, kw:"練習", em:"🎹", yaku:"「最近ピアノをたくさん練習しているね。」「うん、もうすぐ発表会があるんだ。」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:14, stage:"dialog", q:"A: The traffic was terrible this morning.\nB: ( )", c:["I know, I was stuck for an hour.", "It's Monday.", "Yes, please.", "At six."], a:0, kw:"交通", em:"🚗", yaku:"「今朝の交通はひどかったね。」「そうだね、1時間立ち往生したよ。」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:14, stage:"dialog", q:"A: I'm not sure which club to join.\nB: ( )", c:["Why don't you try a few before deciding?", "It's mine.", "Yes, I do.", "At home."], a:0, kw:"アドバイス", em:"🏸", yaku:"「どのクラブに入るか迷っているんだ。」「決める前にいくつか試してみたら？」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:14, stage:"dialog", q:"A: I really appreciate your help with the project.\nB: ( )", c:["It was my pleasure.", "It's Monday.", "Yes, please.", "At six."], a:0, kw:"感謝", em:"🙏", yaku:"「プロジェクトを手伝ってくれて本当に感謝しています。」「どういたしまして。」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:14, stage:"dialog", q:"A: Do you have any suggestions for improving my essay?\nB: ( )", c:["You could add more examples.", "It's mine.", "Yes, I can.", "At home."], a:0, kw:"提案", em:"📄", yaku:"「作文をよくする提案はある？」「もっと例を加えるといいと思う。」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:14, stage:"dialog", q:"A: I heard the new policy will affect our schedule.\nB: ( )", c:["Really? I haven't heard the details yet.", "It's Monday.", "Yes, please.", "At six."], a:0, kw:"知らせ", em:"📋", yaku:"「新しい方針がスケジュールに影響するらしいよ。」「本当？まだ詳細を聞いていないな。」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:14, stage:"dialog", q:"A: I'm torn between two job offers.\nB: ( )", c:["What are the pros and cons of each?", "It's mine.", "Yes, I do.", "At home."], a:0, kw:"相談", em:"💼", yaku:"「2つの仕事のオファーで迷っているんだ。」「それぞれの長所と短所は何？」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:14, stage:"order", q:"This temple ___ built 300 years ago.", c:["was", "is", "did", "has"], a:0, kw:"", em:"🔤", yaku:"このお寺は300年前に建てられました。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:14, stage:"order", q:"I ___ been studying for three hours.", c:["have", "has", "am", "was"], a:0, kw:"", em:"🔤", yaku:"わたしは3時間ずっと勉強しています。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:14, stage:"order", q:"The man ___ car is red is my uncle.", c:["whose", "who", "whom", "which"], a:0, kw:"", em:"🔤", yaku:"車が赤い男性はわたしのおじです。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:14, stage:"order", q:"He said that he ___ busy.", c:["was", "is", "were", "has been"], a:0, kw:"", em:"🔤", yaku:"彼は忙しいと言いました。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:14, stage:"order", q:"If I ___ a bird, I could fly.", c:["were", "am", "was", "will be"], a:0, kw:"", em:"🔤", yaku:"もし鳥だったら、飛べるのに。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:14, stage:"order", q:"My father made me ___ my room.", c:["clean", "to clean", "cleaning", "cleaned"], a:0, kw:"", em:"🔤", yaku:"父はわたしに部屋を掃除させました。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:14, stage:"order", q:"Please turn ___ the light.", c:["off", "on", "up", "down"], a:0, kw:"", em:"🔤", yaku:"明かりを消してください。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:14, stage:"order", q:"The more you read, ___ you learn.", c:["the more", "more", "the most", "most"], a:0, kw:"", em:"🔤", yaku:"読めば読むほど、多く学びます。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:14, stage:"order", q:"Neither he nor I ___ free tomorrow.", c:["am", "is", "are", "was"], a:0, kw:"", em:"🔤", yaku:"彼もわたしも明日は暇ではありません。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:14, stage:"order", q:"I'm used ___ early every day.", c:["to getting up", "to get up", "getting up", "get up"], a:0, kw:"", em:"🔤", yaku:"わたしは毎日早起きすることに慣れています。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:14, stage:"order", q:"It is important ___ recycle.", c:["to", "for", "that", "of"], a:0, kw:"", em:"🔤", yaku:"リサイクルすることは大切です。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:14, stage:"order", q:"I remember ___ him before.", c:["meeting", "to meet", "meet", "met"], a:0, kw:"", em:"🔤", yaku:"わたしは以前彼に会ったのを覚えています。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:14, stage:"order", q:"She stopped ___ when it got dark.", c:["walking", "to walk", "walk", "walked"], a:0, kw:"", em:"🔤", yaku:"彼女は暗くなったとき歩くのをやめました。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:14, stage:"order", q:"This is one of the ___ cities in the world.", c:["biggest", "big", "bigger", "most big"], a:0, kw:"", em:"🔤", yaku:"これは世界で最も大きい都市の一つです。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:14, stage:"order", q:"I wish I ___ more time.", c:["had", "have", "will have", "has"], a:0, kw:"", em:"🔤", yaku:"もっと時間があればいいのに。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:14, stage:"order", q:"The language ___ there is French.", c:["spoken", "speak", "speaking", "spoke"], a:0, kw:"", em:"🔤", yaku:"そこで話されている言語はフランス語です。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:14, stage:"order", q:"A number of people ___ at the event.", c:["were", "was", "is", "has"], a:0, kw:"", em:"🔤", yaku:"多くの人がそのイベントにいました。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:14, stage:"order", q:"She acts as if she ___ the answer.", c:["knew", "knows", "known", "know"], a:0, kw:"", em:"🔤", yaku:"彼女はまるで答えを知っているかのようにふるまいます。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:14, stage:"order", q:"I have no idea ___ to do next.", c:["what", "how", "that", "which"], a:0, kw:"", em:"🔤", yaku:"次に何をすべきか見当もつきません。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:14, stage:"order", q:"English ___ used all over the world.", c:["is", "was", "does", "has"], a:0, kw:"", em:"🔤", yaku:"英語は世界中で使われています。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:14, stage:"read", q:"【掲示】\nCommunity Center Event\nEnglish Speech Contest\nDate: Sunday, September 8\nTime: 1:00 p.m. - 4:00 p.m.\nEntry Fee: 500 yen\nPrizes for the top three speakers!\nSign up at the front desk by September 1.\n→ このイベントは何ですか？", c:["英語スピーチコンテスト", "絵画コンテスト", "音楽コンサート", "料理教室"], a:0, kw:"掲示", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:14, stage:"read", q:"【掲示】(同じ内容)\n→ 申し込みの締め切りはいつですか？", c:["9月1日", "9月8日", "9月10日", "8月1日"], a:0, kw:"掲示", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:14, stage:"read", q:"【掲示】(同じ内容)\n→ 参加費はいくらですか？", c:["500円", "1000円", "無料", "300円"], a:0, kw:"掲示", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:14, stage:"read", q:"【掲示】(同じ内容)\n→ 賞は何人に贈られますか？", c:["上位3人", "全員", "1人だけ", "上位10人"], a:0, kw:"掲示", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:14, stage:"read", q:"【Eメール】\nFrom: Ms. Green\nTo: Members of the drama club\nSubject: Rehearsal Change\n\nHi everyone,\nOur rehearsal this Friday has been moved from the gym to the music room because the gym is being used for a volleyball match. Please bring your scripts. See you there!\nMs. Green\n→ なぜ会場が変更になりましたか？", c:["体育館がバレーボールの試合で使われるから", "音楽室が閉鎖されているから", "雨が降る予定だから", "メンバーが少ないから"], a:0, kw:"Eメール", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:14, stage:"read", q:"【Eメール】(同じ内容)\n→ リハーサルはどこで行われますか？", c:["音楽室", "体育館", "図書室", "校庭"], a:0, kw:"Eメール", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:14, stage:"read", q:"【Eメール】(同じ内容)\n→ メンバーは何を持ってくるべきですか？", c:["台本", "楽器", "運動靴", "飲み物"], a:0, kw:"Eメール", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:14, stage:"read", q:"【説明文】\nRobots are used in many factories today. They can work faster and more accurately than humans in some tasks. However, some people worry that robots will take away jobs from workers. Companies are now trying to find a balance between using robots and keeping human workers.\n→ この文章は主に何について書かれていますか？", c:["工場でのロボットの利用と課題", "ロボットの歴史", "会社の広告", "労働者の休暇"], a:0, kw:"説明文", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:14, stage:"read", q:"【説明文】(同じ内容)\n→ ロボットの利点として書かれていることは？", c:["人間より速く正確に作業できること", "給料が安いこと", "感情があること", "休みが必要ないこと"], a:0, kw:"説明文", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:14, stage:"read", q:"【説明文】(同じ内容)\n→ 一部の人々が心配していることは何ですか？", c:["ロボットが仕事を奪うこと", "ロボットが壊れやすいこと", "ロボットが高すぎること", "ロボットが遅いこと"], a:0, kw:"説明文", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:14, stage:"read", q:"【説明文】(同じ内容)\n→ 企業は今、何をしようとしていますか？", c:["ロボットと人間の労働者のバランスを見つけること", "ロボットをすべて廃止すること", "人間の労働者を減らすこと", "ロボットをもっと増やすこと"], a:0, kw:"説明文", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:14, stage:"read", q:"【説明文】\nCoral reefs are home to thousands of species of fish and other sea creatures. In recent years, rising ocean temperatures have caused many coral reefs to lose their color, a process called coral bleaching. Scientists are working to protect these important ecosystems before it is too late.\n→ サンゴ礁には何が生息していますか？", c:["何千種もの魚や海の生き物", "鳥だけ", "昆虫だけ", "植物だけ"], a:0, kw:"説明文", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:14, stage:"read", q:"【説明文】(同じ内容)\n→ サンゴが色を失う原因は何ですか？", c:["海水温の上昇", "強い風", "漁業", "観光客"], a:0, kw:"説明文", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:14, stage:"read", q:"【説明文】(同じ内容)\n→ 科学者たちは何をしていますか？", c:["生態系を守ろうとしている", "サンゴを食べている", "新しい魚を作っている", "海をきれいに掃除している"], a:0, kw:"説明文", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:14, stage:"read", q:"【日記】\nAugust 10\nToday was the most exciting day of my summer vacation. My family and I went hiking in the mountains. The view from the top was amazing, and we even saw a family of deer. I was tired after the long walk, but it was worth it.\n→ この日、何をしましたか？", c:["山でハイキングをした", "海で泳いだ", "家で本を読んだ", "買い物に行った"], a:0, kw:"日記", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:14, stage:"read", q:"【日記】(同じ内容)\n→ 山の頂上で何を見ましたか？", c:["鹿の家族", "熊", "星空", "川"], a:0, kw:"日記", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:14, stage:"read", q:"【日記】(同じ内容)\n→ 長い散策のあと、どう感じましたか？", c:["疲れたが、価値があった", "退屈だった", "怒っていた", "眠かっただけ"], a:0, kw:"日記", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:14, stage:"read", q:"【説明文】\nThe history of the Olympic torch relay began in 1936. Before each Olympic Games, the torch is carried by runners from Greece to the host city. The relay can take several months and cover thousands of kilometers, passing through many countries along the way.\n→ 聖火リレーはいつ始まりましたか？", c:["1936年", "1896年", "2000年", "1964年"], a:0, kw:"説明文", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:14, stage:"read", q:"【説明文】(同じ内容)\n→ 聖火はどこから運ばれますか？", c:["ギリシャから開催都市まで", "開催都市からギリシャまで", "日本から世界中へ", "アメリカから世界中へ"], a:0, kw:"説明文", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:14, stage:"read", q:"【説明文】(同じ内容)\n→ リレーにはどのくらいの期間がかかりますか？", c:["数か月", "数日", "1年以上", "1週間"], a:0, kw:"説明文", em:"📖", rel:[], exp:"本文の内容から読み取る。"},

  // ===== Lv15  英検®準2級相当 前編(語彙文法) =====
  {lv:15, stage:"vocab", q:"accomplish の 意味は？", c:["成し遂げる", "相談する", "予想する", "実施する"], a:0, kw:"accomplish", em:"🎯", rel:[], exp:"accomplish は 成し遂げる。"},
  {lv:15, stage:"vocab", q:"acknowledge の 意味は？", c:["認める", "実演する", "強調する", "可能にする"], a:0, kw:"acknowledge", em:"✅", rel:[], exp:"acknowledge は 認める。"},
  {lv:15, stage:"vocab", q:"「適応する」は 英語で どれ？", c:["adapt", "highlight", "confront", "deny"], a:0, kw:"adapt", em:"🔄", rel:[], exp:"適応するは adapt。"},
  {lv:15, stage:"vocab", q:"anticipate の 意味は？", c:["予想する", "排除する", "定義する", "評価する"], a:0, kw:"anticipate", em:"🔮", rel:[], exp:"anticipate は 予想する。"},
  {lv:15, stage:"vocab", q:"assess の 意味は？", c:["評価する", "押し上げる", "延長する", "断る・減少する"], a:0, kw:"assess", em:"📊", rel:[], exp:"assess は 評価する。"},
  {lv:15, stage:"vocab", q:"「想定する」は 英語で どれ？", c:["assume", "extend", "enable", "deny"], a:0, kw:"assume", em:"🤔", rel:[], exp:"想定するは assume。"},
  {lv:15, stage:"vocab", q:"boost の 意味は？", c:["押し上げる", "排除する", "批判する", "現れる"], a:0, kw:"boost", em:"📈", rel:[], exp:"boost は 押し上げる。"},
  {lv:15, stage:"vocab", q:"calculate の 意味は？", c:["計算する", "超える", "成し遂げる", "可能にする"], a:0, kw:"calculate", em:"🧮", rel:[], exp:"calculate は 計算する。"},
  {lv:15, stage:"vocab", q:"「明確にする」は 英語で どれ？", c:["clarify", "cultivate", "acknowledge", "demonstrate"], a:0, kw:"clarify", em:"💡", rel:[], exp:"明確にするは clarify。"},
  {lv:15, stage:"vocab", q:"collapse の 意味は？", c:["崩壊する", "否定する", "現れる", "予想する"], a:0, kw:"collapse", em:"💥", rel:[], exp:"collapse は 崩壊する。"},
  {lv:15, stage:"vocab", q:"combine の 意味は？", c:["結合する", "延長する", "明確にする", "想定する"], a:0, kw:"combine", em:"🔗", rel:[], exp:"combine は 結合する。"},
  {lv:15, stage:"vocab", q:"「理解する」は 英語で どれ？", c:["comprehend", "detect", "consume", "enable"], a:0, kw:"comprehend", em:"🧠", rel:[], exp:"理解するは comprehend。"},
  {lv:15, stage:"vocab", q:"conduct の 意味は？", c:["実施する", "実演する", "適応する", "ささげる"], a:0, kw:"conduct", em:"📋", rel:[], exp:"conduct は 実施する。"},
  {lv:15, stage:"vocab", q:"confront の 意味は？", c:["立ち向かう", "想定する", "明確にする", "排除する"], a:0, kw:"confront", em:"😤", rel:[], exp:"confront は 立ち向かう。"},
  {lv:15, stage:"vocab", q:"「保護する」は 英語で どれ？", c:["conserve", "define", "extend", "decline"], a:0, kw:"conserve", em:"🌳", rel:[], exp:"保護するは conserve。"},
  {lv:15, stage:"vocab", q:"consult の 意味は？", c:["相談する", "立ち向かう", "理解する", "崩壊する"], a:0, kw:"consult", em:"💬", rel:[], exp:"consult は 相談する。"},
  {lv:15, stage:"vocab", q:"consume の 意味は？", c:["消費する", "強調する", "ささげる", "実演する"], a:0, kw:"consume", em:"🍽️", rel:[], exp:"consume は 消費する。"},
  {lv:15, stage:"vocab", q:"「対処する」は 英語で どれ？", c:["cope", "highlight", "demonstrate", "dominate"], a:0, kw:"cope", em:"💪", rel:[], exp:"対処するは cope。"},
  {lv:15, stage:"vocab", q:"criticize の 意味は？", c:["批判する", "予想する", "実演する", "生み出す"], a:0, kw:"criticize", em:"😠", rel:[], exp:"criticize は 批判する。"},
  {lv:15, stage:"vocab", q:"cultivate の 意味は？", c:["育てる", "区別する", "ささげる", "予想する"], a:0, kw:"cultivate", em:"🌱", rel:[], exp:"cultivate は 育てる。"},
  {lv:15, stage:"vocab", q:"「断る・減少する」は 英語で どれ？", c:["decline", "detect", "collapse", "generate"], a:0, kw:"decline", em:"📉", rel:[], exp:"断る・減少するは decline。"},
  {lv:15, stage:"vocab", q:"define の 意味は？", c:["定義する", "結合する", "ささげる", "生み出す"], a:0, kw:"define", em:"📖", rel:[], exp:"define は 定義する。"},
  {lv:15, stage:"vocab", q:"demonstrate の 意味は？", c:["実演する", "支配する", "超える", "生み出す"], a:0, kw:"demonstrate", em:"🎬", rel:[], exp:"demonstrate は 実演する。"},
  {lv:15, stage:"vocab", q:"「否定する」は 英語で どれ？", c:["deny", "enable", "define", "dominate"], a:0, kw:"deny", em:"🚫", rel:[], exp:"否定するは deny。"},
  {lv:15, stage:"vocab", q:"detect の 意味は？", c:["検出する", "評価する", "区別する", "可能にする"], a:0, kw:"detect", em:"🔍", rel:[], exp:"detect は 検出する。"},
  {lv:15, stage:"vocab", q:"devote の 意味は？", c:["ささげる", "耐える", "対処する", "超える"], a:0, kw:"devote", em:"❤️", rel:[], exp:"devote は ささげる。"},
  {lv:15, stage:"vocab", q:"「区別する」は 英語で どれ？", c:["distinguish", "anticipate", "emphasize", "enable"], a:0, kw:"distinguish", em:"⚖️", rel:[], exp:"区別するは distinguish。"},
  {lv:15, stage:"vocab", q:"dominate の 意味は？", c:["支配する", "想定する", "現れる", "定義する"], a:0, kw:"dominate", em:"👑", rel:[], exp:"dominate は 支配する。"},
