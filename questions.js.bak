  {lv:10, stage:"talk", q:"How are you? — ___", c:["I'm fine, thank you.","Yes, I do.","It's Monday.","You're welcome."], a:0, kw:"あいさつ", em:"💬", yaku:"「元気ですか？」「元気です、ありがとう。」", rel:[], exp:"体調には I'm fine, thank you.。"},
  {lv:10, stage:"talk", q:"What time is it? — ___", c:["It's three o'clock.","I'm eleven.","It's sunny.","Yes, please."], a:0, kw:"時間", em:"🕒", yaku:"「今、何時ですか？」「3時です。」", rel:[], exp:"時刻は It's 〜 o'clock.。"},
  {lv:10, stage:"talk", q:"Whose bag is this? — ___", c:["It's mine.","I'm fine.","Yes, it is.","On Sunday."], a:0, kw:"だれの", em:"🎒", yaku:"「これはだれのかばん？」「わたしのです。」", rel:[], exp:"Whose には mine 等。"},
  {lv:10, stage:"talk", q:"Can you swim? — ___", c:["Yes, I can.","It's a dog.","I'm hungry.","At school."], a:0, kw:"can", em:"🏊", yaku:"「泳げますか？」「はい、泳げます。」", rel:[], exp:"Can you〜? には Yes, I can.。"},
  {lv:10, stage:"talk", q:"Let's play soccer. — ___", c:["Yes, let's!","You're welcome.","It's red.","No, I'm not."], a:0, kw:"さそい", em:"⚽", yaku:"「サッカーをしよう。」「うん、しよう！」", rel:[], exp:"Let's〜 には Yes, let's!。"},
  {lv:10, stage:"talk", q:"What color do you like? — ___", c:["I like blue.","It's Monday.","Yes, I do.","At home."], a:0, kw:"色", em:"🎨", yaku:"「何色が好き？」「青が好きです。」", rel:[], exp:"好きな色を答える。"},
  {lv:10, stage:"talk", q:"Where is my cap? — ___", c:["It's on the bed.","I'm ten.","It's rainy.","Thank you."], a:0, kw:"場所", em:"🧢", yaku:"「ぼうしはどこ？」「ベッドの上だよ。」", rel:[], exp:"Where には場所で答える。"},
  {lv:10, stage:"talk", q:"Nice to meet you. — ___", c:["Nice to meet you, too.","No, thank you.","It's mine.","See you."], a:0, kw:"あいさつ", em:"🤝", yaku:"「はじめまして。」「こちらこそ。」", rel:[], exp:"〜, too. で返す。"},
  {lv:10, stage:"talk", q:"What's your name? — ___", c:["My name is Ken.","I'm fine.","It's Monday.","Yes, I do."], a:0, kw:"名前", em:"📛", yaku:"「お名前は？」「ケンです。」", rel:[], exp:"名前は My name is 〜.。"},
