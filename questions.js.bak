  {lv:10, stage:"grammar", q:"___ color do you like? — Red.", c:["What","Who","Where","When"], a:0, kw:"疑問詞", em:"🎨", yaku:"何色が好きですか？—赤です。", rel:[], exp:"What+名詞で「何の〜」。"},
