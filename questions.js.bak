  {lv:10, stage:"grammar", q:"The cat is ___ the box.（中に）", c:["in","on","under","to"], a:0, kw:"前置詞", em:"📦", yaku:"ねこは箱の中にいます。", rel:[], exp:"「中に」は in。"},
  {lv:10, stage:"grammar", q:"___ is a book on the desk.", c:["There","It","This","That"], a:0, kw:"There is", em:"📖", yaku:"机の上に本が（1冊）あります。", rel:[], exp:"「〜がある」は There is。"},
