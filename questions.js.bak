  {lv:10, stage:"read", q:"My name is Emi. I am twelve years old. I like music. → エミが 好きな ものは？", c:["音楽","スポーツ","算数","絵"], a:0, kw:"読解", em:"🎵", yaku:"わたしはエミ。12歳です。音楽が好きです。", rel:[], exp:"I like music. より。"},
  {lv:10, stage:"read", q:"My name is Emi. I am twelve years old. I like music. → エミは 何歳？", c:["12歳","10歳","11歳","13歳"], a:0, kw:"読解", em:"🎂", yaku:"わたしはエミ。12歳です。音楽が好きです。", rel:[], exp:"twelve years old より。"},
  {lv:10, stage:"read", q:"I have a dog. Its name is Pochi. It is white. → 犬の 名前は？", c:["Pochi","Tama","Kuro","Shiro"], a:0, kw:"読解", em:"🐶", yaku:"犬を飼っています。名前はポチです。白い犬です。", rel:[], exp:"Its name is Pochi. より。"},
  {lv:10, stage:"read", q:"I have a dog. Its name is Pochi. It is white. → 犬は 何色？", c:["白","黒","茶","灰色"], a:0, kw:"読解", em:"🎨", yaku:"犬を飼っています。名前はポチです。白い犬です。", rel:[], exp:"It is white. より。"},
  {lv:10, stage:"read", q:"Tom gets up at six. He goes to school at eight. → トムは 何時に 起きる？", c:["6時","7時","8時","5時"], a:0, kw:"読解", em:"⏰", yaku:"トムは6時に起きます。8時に学校へ行きます。", rel:[], exp:"gets up at six より。"},
  {lv:10, stage:"read", q:"Tom gets up at six. He goes to school at eight. → 何時に 学校へ 行く？", c:["8時","6時","7時","9時"], a:0, kw:"読解", em:"🏫", yaku:"トムは6時に起きます。8時に学校へ行きます。", rel:[], exp:"goes to school at eight より。"},
  {lv:10, stage:"read", q:"I play tennis on Sunday. I play with my father. → いつ テニスを する？", c:["日曜日","土曜日","毎日","月曜日"], a:0, kw:"読解", em:"🎾", yaku:"わたしは日曜日にテニスをします。父と一緒にします。", rel:[], exp:"on Sunday より。"},
  {lv:10, stage:"read", q:"I play tennis on Sunday. I play with my father. → だれと する？", c:["父","母","兄","友だち"], a:0, kw:"読解", em:"👨", yaku:"わたしは日曜日にテニスをします。父と一緒にします。", rel:[], exp:"with my father より。"},
  {lv:10, stage:"read", q:"The library is next to the station. It opens at nine. → 図書館は どこ？", c:["駅のとなり","公園の中","学校の前","川のそば"], a:0, kw:"読解", em:"📚", yaku:"図書館は駅のとなりです。9時に開きます。", rel:[], exp:"next to the station より。"},
  {lv:10, stage:"read", q:"The library is next to the station. It opens at nine. → 何時に 開く？", c:["9時","8時","10時","7時"], a:0, kw:"読解", em:"🕘", yaku:"図書館は駅のとなりです。9時に開きます。", rel:[], exp:"opens at nine より。"},
  {lv:10, stage:"read", q:"Ken has two brothers and one sister. → ケンの きょうだいは 何人？", c:["3人","2人","1人","4人"], a:0, kw:"読解", em:"👨‍👩‍👦", yaku:"ケンには兄弟が2人、姉妹が1人います。", rel:[], exp:"2+1=3人。"},
  {lv:10, stage:"read", q:"My favorite subject is science. I study it on Monday and Friday. → 好きな 教科は？", c:["理科","算数","英語","音楽"], a:0, kw:"読解", em:"🔬", yaku:"わたしの好きな教科は理科です。月曜と金曜に勉強します。", rel:[], exp:"favorite subject is science より。"},
  {lv:10, stage:"read", q:"My favorite subject is science. I study it on Monday and Friday. → いつ 勉強する？", c:["月曜と金曜","火曜と木曜","毎日","日曜"], a:0, kw:"読解", em:"📅", yaku:"わたしの好きな教科は理科です。月曜と金曜に勉強します。", rel:[], exp:"on Monday and Friday より。"},
  {lv:10, stage:"read", q:"There are five apples on the table. I eat two apples. → テーブルに りんごは いくつ？", c:["5個","2個","3個","4個"], a:0, kw:"読解", em:"🍎", yaku:"テーブルにりんごが5個あります。わたしは2個食べます。", rel:[], exp:"five apples より。"},
  {lv:10, stage:"read", q:"There are five apples on the table. I eat two apples. → いくつ 食べた？", c:["2個","5個","3個","1個"], a:0, kw:"読解", em:"🍏", yaku:"テーブルにりんごが5個あります。わたしは2個食べます。", rel:[], exp:"eat two apples より。"},
  {lv:10, stage:"read", q:"It is rainy today. I don't play soccer. I read a book at home. → 今日の 天気は？", c:["雨","晴れ","くもり","雪"], a:0, kw:"読解", em:"🌧️", yaku:"今日は雨です。サッカーはしません。家で本を読みます。", rel:[], exp:"rainy today より。"},
  {lv:10, stage:"read", q:"It is rainy today. I don't play soccer. I read a book at home. → 家で 何を する？", c:["本を読む","サッカー","料理","そうじ"], a:0, kw:"読解", em:"📖", yaku:"今日は雨です。サッカーはしません。家で本を読みます。", rel:[], exp:"read a book at home より。"},
  {lv:10, stage:"read", q:"Yumi wants a new camera. It is fifty dollars. She has thirty dollars. → ユミが ほしい ものは？", c:["カメラ","自転車","時計","ぼうし"], a:0, kw:"読解", em:"📷", yaku:"ユミは新しいカメラがほしいです。50ドルです。彼女は30ドル持っています。", rel:[], exp:"wants a new camera より。"},
  {lv:10, stage:"read", q:"Yumi wants a new camera. It is fifty dollars. She has thirty dollars. → カメラは いくら？", c:["50ドル","30ドル","15ドル","5ドル"], a:0, kw:"読解", em:"💰", yaku:"ユミは新しいカメラがほしいです。50ドルです。彼女は30ドル持っています。", rel:[], exp:"fifty dollars より。"},
  {lv:10, stage:"read", q:"Yumi wants a new camera. It is fifty dollars. She has thirty dollars. → ユミは 何ドル 持っている？", c:["30ドル","50ドル","20ドル","13ドル"], a:0, kw:"読解", em:"💵", yaku:"ユミは新しいカメラがほしいです。50ドルです。彼女は30ドル持っています。", rel:[], exp:"has thirty dollars より。"},
  {lv:10, stage:"read", q:"We have a music class on Wednesday. Our teacher is Mr. Tanaka. → 音楽の 授業は いつ？", c:["水曜日","月曜日","金曜日","火曜日"], a:0, kw:"読解", em:"🎶", yaku:"水曜日に音楽の授業があります。先生は田中先生です。", rel:[], exp:"on Wednesday より。"},
  {lv:10, stage:"read", q:"We have a music class on Wednesday. Our teacher is Mr. Tanaka. → 先生は だれ？", c:["田中先生","山田先生","エミ","トム"], a:0, kw:"読解", em:"🧑‍🏫", yaku:"水曜日に音楽の授業があります。先生は田中先生です。", rel:[], exp:"Mr. Tanaka より。"},
  {lv:10, stage:"read", q:"I go to the zoo with my family. I like the pandas. → どこへ 行く？", c:["動物園","公園","図書館","海"], a:0, kw:"読解", em:"🦁", yaku:"わたしは家族と動物園へ行きます。パンダが好きです。", rel:[], exp:"go to the zoo より。"},
  {lv:10, stage:"read", q:"I go to the zoo with my family. I like the pandas. → だれと 行く？", c:["家族","友だち","先生","一人で"], a:0, kw:"読解", em:"👪", yaku:"わたしは家族と動物園へ行きます。パンダが好きです。", rel:[], exp:"with my family より。"},
  {lv:10, stage:"read", q:"I go to the zoo with my family. I like the pandas. → 何が 好き？", c:["パンダ","ライオン","ぞう","さる"], a:0, kw:"読解", em:"🐼", yaku:"わたしは家族と動物園へ行きます。パンダが好きです。", rel:[], exp:"I like the pandas. より。"},

