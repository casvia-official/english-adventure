  {lv:16, stage:"fill", q:"I would rather ___ at home than go out tonight.", c:["stay", "to stay", "staying", "stayed"], a:0, kw:"would rather", em:"🏠", yaku:"今夜は出かけるより家にいたいです。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"It is high time we ___ a decision.", c:["made", "make", "making", "makes"], a:0, kw:"it's high time", em:"⏰", yaku:"そろそろ決断すべき時です。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"___ the heavy rain, the event was held as planned.", c:["Despite", "Although", "Because", "Unless"], a:0, kw:"despite+名詞", em:"🌧️", yaku:"大雨にもかかわらず、そのイベントは予定通り開催されました。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"The festival was canceled ___ the typhoon.", c:["due to", "although", "unless", "despite"], a:0, kw:"due to", em:"🌀", yaku:"台風のため、その祭りは中止されました。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"___ of studying, he decided to travel for a year.", c:["Instead", "Rather", "Despite", "Because"], a:0, kw:"instead of", em:"✈️", yaku:"勉強する代わりに、彼は1年間旅をすることに決めました。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"She works part-time ___ order to save money for college.", c:["in", "for", "so", "on"], a:0, kw:"in order to", em:"🎓", yaku:"彼女は大学のためにお金を貯めるためにアルバイトをしています。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"I got my phone ___ while I was traveling.", c:["stolen", "steal", "stealing", "steals"], a:0, kw:"受け身の使役(get done)", em:"📱", yaku:"旅行中に携帯電話を盗まれました。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"The bridge is ___ construction and will open next year.", c:["under", "in", "on", "at"], a:0, kw:"under construction", em:"🏗️", yaku:"その橋は建設中で、来年開通します。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"Whether you agree ___ not, the decision has been made.", c:["or", "and", "nor", "but"], a:0, kw:"whether...or not", em:"🤝", yaku:"賛成しようとしまいと、決定はすでになされました。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"As long ___ you follow the rules, you can join the club.", c:["as", "that", "if", "so"], a:0, kw:"as long as", em:"📋", yaku:"規則を守る限り、クラブに参加できます。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"Provided ___ the weather is good, we will have the picnic outside.", c:["that", "if", "unless", "when"], a:0, kw:"provided that", em:"🧺", yaku:"天気が良ければ、外でピクニックをします。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"The more information we gather, ___ our decision will be.", c:["the better", "better", "the best", "good"], a:0, kw:"the比較級構文", em:"📊", yaku:"情報を集めれば集めるほど、決断はより良いものになります。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"It is said ___ this castle is over 500 years old.", c:["that", "if", "which", "what"], a:0, kw:"it is said that", em:"🏰", yaku:"この城は500年以上前のものだと言われています。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"The fact ___ she apologized surprised everyone.", c:["that", "which", "what", "who"], a:0, kw:"同格のthat", em:"😲", yaku:"彼女が謝ったという事実は皆を驚かせました。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"Not until I read the letter ___ I understand his feelings.", c:["did", "do", "had", "have"], a:0, kw:"倒置(not until)", em:"✉️", yaku:"その手紙を読むまで、わたしは彼の気持ちを理解しませんでした。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"Rarely ___ such a beautiful sunset.", c:["have I seen", "I have seen", "I saw", "did I saw"], a:0, kw:"倒置(rarely)", em:"🌇", yaku:"こんなに美しい夕焼けを見たことはめったにありません。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"He is said ___ have lived in Paris for ten years.", c:["to", "that", "for", "of"], a:0, kw:"be said to have", em:"🗼", yaku:"彼はパリに10年間住んでいたと言われています。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"The company is expected ___ its profits next year.", c:["to increase", "increase", "increasing", "increased"], a:0, kw:"be expected to", em:"📈", yaku:"その会社は来年利益を増やすと期待されています。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"fill", q:"Given ___ he is new here, he is doing very well.", c:["that", "if", "unless", "although"], a:0, kw:"given that", em:"👍", yaku:"彼がここに来たばかりであることを考えると、とてもよくやっています。", rel:[], exp:"文脈と文法から判断する。"},
  {lv:16, stage:"dialog", q:"A: I've been offered a job overseas, but I'm not sure whether to take it.\nB: ( )", c:["What matters most to you in this decision?", "It's Monday.", "I'm fine.", "At six."], a:0, kw:"相談", em:"🌏", yaku:"「海外の仕事のオファーがあったけど、受けるか迷っているんだ。」「この決断で一番大切なことは何？」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:16, stage:"dialog", q:"A: The negotiations broke down again this morning.\nB: ( )", c:["That's disappointing. What went wrong this time?", "It's mine.", "Yes, please.", "At home."], a:0, kw:"交渉", em:"🤝", yaku:"「今朝また交渉が決裂したよ。」「残念だね。今回は何がうまくいかなかったの？」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:16, stage:"dialog", q:"A: I've been putting off my dentist appointment for months.\nB: ( )", c:["You really should take care of that soon.", "It's Monday.", "Yes, I do.", "At six."], a:0, kw:"アドバイス", em:"🦷", yaku:"「歯医者の予約を何か月も先延ばしにしているんだ。」「本当にすぐ対処したほうがいいよ。」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:16, stage:"dialog", q:"A: Our sales have declined significantly this quarter.\nB: ( )", c:["We need to figure out the cause right away.", "It's mine.", "Yes, please.", "At home."], a:0, kw:"ビジネス", em:"📉", yaku:"「今四半期の売上が大幅に減少したよ。」「すぐに原因を突き止める必要があるね。」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:16, stage:"dialog", q:"A: I can't decide between studying abroad or staying here for university.\nB: ( )", c:["Both have pros and cons. Take your time.", "It's Monday.", "Yes, I can.", "At six."], a:0, kw:"進路", em:"🎓", yaku:"「留学するかここで大学に通うか決められないんだ。」「どちらにも長所短所があるから、じっくり考えて。」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:16, stage:"dialog", q:"A: The project deadline has been moved up by a week.\nB: ( )", c:["That's tight, but I think we can manage.", "It's mine.", "Yes, please.", "At home."], a:0, kw:"仕事", em:"📅", yaku:"「プロジェクトの締め切りが1週間早まったよ。」「厳しいけど、何とかなると思う。」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:16, stage:"dialog", q:"A: I'm worried my presentation isn't persuasive enough.\nB: ( )", c:["Try adding more concrete data to support your points.", "It's Monday.", "Yes, I do.", "At six."], a:0, kw:"プレゼン", em:"📊", yaku:"「プレゼンの説得力が足りない気がして心配なんだ。」「主張を裏づける具体的なデータを増やしてみたら。」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:16, stage:"dialog", q:"A: The committee couldn't reach a consensus on the new policy.\nB: ( )", c:["Maybe they need more time to discuss the details.", "It's mine.", "Yes, please.", "At home."], a:0, kw:"会議", em:"🏛️", yaku:"「委員会は新しい方針で合意に達しなかったんだ。」「もっと詳細を話し合う時間が必要かもね。」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:16, stage:"dialog", q:"A: I've been trying to cut down on my screen time lately.\nB: ( )", c:["That's a good habit. How's it going so far?", "It's Monday.", "Yes, I can.", "At six."], a:0, kw:"生活習慣", em:"📱", yaku:"「最近スクリーンタイムを減らそうとしているんだ。」「いい習慣だね。今のところどう？」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:16, stage:"dialog", q:"A: The survey results were completely different from what we expected.\nB: ( )", c:["That's interesting. What do you think caused that?", "It's mine.", "Yes, please.", "At home."], a:0, kw:"調査", em:"📋", yaku:"「アンケート結果が予想と全く違ったよ。」「興味深いね。何が原因だと思う？」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:16, stage:"dialog", q:"A: I'm considering switching my major to economics.\nB: ( )", c:["What made you interested in that field?", "It's Monday.", "Yes, I do.", "At six."], a:0, kw:"進路", em:"💹", yaku:"「専攻を経済学に変えようか考えているんだ。」「何がきっかけでその分野に興味を持ったの？」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:16, stage:"dialog", q:"A: Our team missed the quarterly target again.\nB: ( )", c:["Let's analyze what's holding us back.", "It's mine.", "Yes, please.", "At home."], a:0, kw:"ビジネス", em:"📉", yaku:"「チームがまた四半期の目標を達成できなかったよ。」「何が足を引っ張っているか分析しよう。」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:16, stage:"dialog", q:"A: I feel like I'm not making progress no matter how hard I try.\nB: ( )", c:["Progress isn't always visible right away. Keep going.", "It's Monday.", "Yes, I can.", "At six."], a:0, kw:"励まし", em:"💪", yaku:"「どんなに頑張っても進歩していない気がするんだ。」「進歩はすぐには見えないこともあるよ。続けて。」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:16, stage:"dialog", q:"A: The government announced a new environmental policy today.\nB: ( )", c:["I wonder how it will affect local businesses.", "It's mine.", "Yes, please.", "At home."], a:0, kw:"時事", em:"🌍", yaku:"「今日、政府が新しい環境政策を発表したよ。」「地元の企業にどう影響するのか気になるね。」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:16, stage:"dialog", q:"A: I'm not confident about my English interview next week.\nB: ( )", c:["Let's practice some common questions together.", "It's Monday.", "Yes, I do.", "At six."], a:0, kw:"面接", em:"💼", yaku:"「来週の英語面接に自信がないんだ。」「一緒によくある質問を練習しよう。」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:16, stage:"dialog", q:"A: Our flight got delayed by three hours because of the storm.\nB: ( )", c:["That's frustrating. Did they give any compensation?", "It's mine.", "Yes, please.", "At home."], a:0, kw:"トラブル", em:"✈️", yaku:"「嵐で飛行機が3時間遅れたよ。」「いらいらするね。何か補償はあった？」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:16, stage:"dialog", q:"A: I've noticed a gradual decline in my motivation lately.\nB: ( )", c:["Maybe you need to set smaller, achievable goals.", "It's Monday.", "Yes, I can.", "At six."], a:0, kw:"相談", em:"😞", yaku:"「最近やる気が徐々に落ちてきているのに気づいたんだ。」「もっと小さくて達成しやすい目標を立ててみたら。」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:16, stage:"dialog", q:"A: The company is planning to expand into overseas markets.\nB: ( )", c:["That sounds like a big but exciting step.", "It's mine.", "Yes, please.", "At home."], a:0, kw:"ビジネス", em:"🌐", yaku:"「会社は海外市場への進出を計画しているんだ。」「大きいけどわくわくする一歩だね。」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:16, stage:"dialog", q:"A: I'm torn between pursuing my passion and choosing a stable career.\nB: ( )", c:["Is there a way to combine both?", "It's Monday.", "Yes, I do.", "At six."], a:0, kw:"進路", em:"🎨", yaku:"「情熱を追うか安定した仕事を選ぶかで迷っているんだ。」「両方を組み合わせる方法はないかな？」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:16, stage:"dialog", q:"A: We received a lot of criticism after the announcement.\nB: ( )", c:["It might help to address their concerns directly.", "It's mine.", "Yes, please.", "At home."], a:0, kw:"批判対応", em:"📢", yaku:"「発表の後、たくさんの批判を受けたよ。」「彼らの懸念に直接向き合うといいかもしれないね。」", rel:[], exp:"会話の流れに合う返事を選ぶ。"},
  {lv:16, stage:"order", q:"By the time I arrived, the train ___ already left.", c:["had", "has", "was", "did"], a:0, kw:"", em:"🔤", yaku:"わたしが着いたときには、電車はすでに出発していました。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:16, stage:"order", q:"___ it snows tomorrow, we will play outside.", c:["Unless", "If", "Although", "Because"], a:0, kw:"", em:"🔤", yaku:"もし明日雪が降らなければ、外で遊びます。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:16, stage:"order", q:"It was Ken ___ solved the problem.", c:["that", "who is", "which", "what"], a:0, kw:"", em:"🔤", yaku:"その問題を解いたのはケンでした。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:16, stage:"order", q:"This is the house ___ I grew up.", c:["where", "which", "that", "who"], a:0, kw:"", em:"🔤", yaku:"ここはわたしが育った家です。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:16, stage:"order", q:"You must have ___ hard to win the prize.", c:["worked", "work", "working", "works"], a:0, kw:"", em:"🔤", yaku:"賞を取るなんて、一生けんめい働いたにちがいありません。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:16, stage:"order", q:"___ tired, she kept smiling.", c:["Being", "Be", "Been", "To be"], a:0, kw:"", em:"🔤", yaku:"疲れていたけれど、彼女は笑顔を保ちました。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:16, stage:"order", q:"I had my bike ___ yesterday.", c:["repaired", "repair", "repairing", "repairs"], a:0, kw:"", em:"🔤", yaku:"わたしは昨日、自転車を修理してもらいました。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:16, stage:"order", q:"You had better ___ now.", c:["leave", "to leave", "leaving", "left"], a:0, kw:"", em:"🔤", yaku:"今すぐ出発したほうがいいですよ。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:16, stage:"order", q:"___ the rain, we enjoyed the festival.", c:["Despite", "Although", "Because", "Unless"], a:0, kw:"", em:"🔤", yaku:"雨にもかかわらず、わたしたちは祭りを楽しみました。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:16, stage:"order", q:"As long ___ you try your best, that's enough.", c:["as", "that", "if", "so"], a:0, kw:"", em:"🔤", yaku:"最善を尽くす限り、それで十分です。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:16, stage:"order", q:"The more you practice, ___ you get.", c:["the better", "better", "the best", "good"], a:0, kw:"", em:"🔤", yaku:"練習すればするほど、上達します。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:16, stage:"order", q:"It is said ___ this tree is 1000 years old.", c:["that", "if", "which", "what"], a:0, kw:"", em:"🔤", yaku:"この木は1000年前のものだと言われています。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:16, stage:"order", q:"The fact ___ he lied surprised us.", c:["that", "which", "what", "who"], a:0, kw:"", em:"🔤", yaku:"彼が嘘をついたという事実はわたしたちを驚かせました。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:16, stage:"order", q:"He is said ___ have won many awards.", c:["to", "that", "for", "of"], a:0, kw:"", em:"🔤", yaku:"彼は多くの賞を受賞したと言われています。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:16, stage:"order", q:"The number is expected ___ next year.", c:["to rise", "rise", "rising", "rose"], a:0, kw:"", em:"🔤", yaku:"その数は来年上がると予想されています。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:16, stage:"order", q:"Given ___ she just started, she is doing well.", c:["that", "if", "unless", "although"], a:0, kw:"", em:"🔤", yaku:"彼女が始めたばかりであることを考えると、よくやっています。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:16, stage:"order", q:"I would rather ___ than eat outside tonight.", c:["cook", "to cook", "cooking", "cooked"], a:0, kw:"", em:"🔤", yaku:"今夜は外食するより料理したいです。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:16, stage:"order", q:"It is high time we ___ home.", c:["went", "go", "going", "goes"], a:0, kw:"", em:"🔤", yaku:"そろそろ帰る時間です。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:16, stage:"order", q:"Whether it rains ___ not, we will go.", c:["or", "and", "nor", "but"], a:0, kw:"", em:"🔤", yaku:"雨が降ろうと降るまいと、わたしたちは行きます。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:16, stage:"order", q:"Provided ___ you finish on time, you can leave early.", c:["that", "if", "unless", "when"], a:0, kw:"", em:"🔤", yaku:"時間通りに終わらせれば、早く帰ってもいいです。", rel:[], exp:"和文の意味に合う英文を選ぶ。"},
  {lv:16, stage:"read", q:"【広告】\nGrand Opening: Riverside Fitness Center\nJoin before September 30 and get 20% off your first three months!\nFacilities include a swimming pool, yoga studio, and 24-hour gym.\nFree trial session available every Saturday.\n→ この広告は何を宣伝していますか？", c:["新しいフィットネスセンター", "新しいレストラン", "新しい図書館", "新しい病院"], a:0, kw:"広告", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:16, stage:"read", q:"【広告】(同じ内容)\n→ 割引を受けるための条件は？", c:["9月30日までに入会すること", "毎日通うこと", "現金で払うこと", "友だちを連れてくること"], a:0, kw:"広告", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:16, stage:"read", q:"【広告】(同じ内容)\n→ 無料体験はいつ受けられますか？", c:["毎週土曜日", "毎週日曜日", "毎日", "月に1回"], a:0, kw:"広告", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:16, stage:"read", q:"【Eメール】\nFrom: HR Department\nTo: All Employees\nSubject: Remote Work Policy Update\n\nStarting next month, employees will be allowed to work from home up to two days a week, provided that their manager approves the schedule in advance. Please submit your preferred remote days by the end of this week.\n→ このメールの主な内容は何ですか？", c:["在宅勤務方針の変更", "給料の引き上げ", "新しいオフィスの場所", "休暇制度の変更"], a:0, kw:"Eメール", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:16, stage:"read", q:"【Eメール】(同じ内容)\n→ 在宅勤務をするための条件は？", c:["上司が事前にスケジュールを承認すること", "毎日申請すること", "週5日働くこと", "経験年数が5年以上あること"], a:0, kw:"Eメール", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:16, stage:"read", q:"【Eメール】(同じ内容)\n→ 社員はいつまでに希望日を提出すべきですか？", c:["今週末までに", "来月末までに", "今日中に", "来週の初めまでに"], a:0, kw:"Eメール", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:16, stage:"read", q:"【説明文】\nArtificial intelligence is increasingly used in fields such as medicine, transportation, and education. While AI can process large amounts of data quickly, some experts warn that over-reliance on technology may reduce human critical thinking skills. Balancing innovation with caution remains an important challenge.\n→ この文章のテーマは何ですか？", c:["AIの活用とその課題", "AIの歴史", "医療の発展史", "教育制度の変化"], a:0, kw:"説明文", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:16, stage:"read", q:"【説明文】(同じ内容)\n→ AIの利点として挙げられているのは？", c:["大量のデータを素早く処理できること", "感情を持つこと", "人間より賢いこと", "無料で使えること"], a:0, kw:"説明文", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:16, stage:"read", q:"【説明文】(同じ内容)\n→ 専門家が警告していることは？", c:["技術に頼りすぎると批判的思考力が低下するかもしれないこと", "AIが仕事を全て奪うこと", "AIが危険であること", "AIが高すぎること"], a:0, kw:"説明文", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:16, stage:"read", q:"【説明文】\nMicroplastics, tiny pieces of plastic less than five millimeters in size, have been found in oceans, rivers, and even drinking water. Scientists are still studying the long-term effects of microplastics on human health and ecosystems, but many governments have already begun restricting single-use plastics.\n→ マイクロプラスチックとは何ですか？", c:["5ミリ未満の小さなプラスチック片", "大きなプラスチックごみ", "海の生き物の一種", "新しい素材の名前"], a:0, kw:"説明文", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:16, stage:"read", q:"【説明文】(同じ内容)\n→ マイクロプラスチックはどこで見つかっていますか？", c:["海・川・飲料水", "宇宙のみ", "山の頂上のみ", "家の中だけ"], a:0, kw:"説明文", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:16, stage:"read", q:"【説明文】(同じ内容)\n→ 多くの政府がすでに始めていることは？", c:["使い捨てプラスチックの規制", "マイクロプラスチックの販売", "新しい海の開発", "プラスチック工場の増設"], a:0, kw:"説明文", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:16, stage:"read", q:"【説明文】\nRemote work has changed the way many companies operate. While employees often report greater flexibility and improved work-life balance, some managers find it more difficult to build a strong team culture. Companies are now experimenting with hybrid models that combine in-office and remote work.\n→ リモートワークによって従業員が得たと報告しているものは？", c:["柔軟性とより良いワークライフバランス", "より高い給料", "短い通勤時間だけ", "無料の食事"], a:0, kw:"説明文", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:16, stage:"read", q:"【説明文】(同じ内容)\n→ 一部の管理者が難しいと感じていることは？", c:["強いチーム文化を築くこと", "従業員を採用すること", "給料を計算すること", "会議を開くこと"], a:0, kw:"説明文", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:16, stage:"read", q:"【説明文】(同じ内容)\n→ 企業は今、何を試していますか？", c:["オフィス勤務とリモートワークを組み合わせたモデル", "全員を解雇すること", "全員をオフィスに戻すこと", "会社を閉じること"], a:0, kw:"説明文", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:16, stage:"read", q:"【説明文】\nThe concept of a four-day workweek has gained attention worldwide. Trial programs in several countries showed that employees maintained productivity while working fewer hours, and many reported reduced stress levels. However, critics argue that this model may not be feasible for all industries.\n→ 週4日勤務制について何が分かりましたか？", c:["労働時間が減っても生産性が保たれた", "生産性が大きく下がった", "給料が上がらなかった", "誰も参加しなかった"], a:0, kw:"説明文", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:16, stage:"read", q:"【説明文】(同じ内容)\n→ 従業員が報告したことは？", c:["ストレスの軽減", "仕事量の増加", "給料の減少", "休暇が減ったこと"], a:0, kw:"説明文", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:16, stage:"read", q:"【説明文】(同じ内容)\n→ 批評家が主張していることは？", c:["すべての業界に適しているとは限らないこと", "この制度は完璧であること", "すぐに廃止すべきこと", "違法であること"], a:0, kw:"説明文", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:16, stage:"read", q:"【説明文】\nUrban farming, the practice of growing food within city environments, is becoming more popular as a way to reduce transportation costs and provide fresh produce to city residents. Rooftop gardens and vertical farms are two common approaches used in crowded cities.\n→ 都市農業の目的として書かれていることは？", c:["輸送コストを減らし新鮮な食料を提供すること", "都市を拡大すること", "観光客を増やすこと", "土地の値段を上げること"], a:0, kw:"説明文", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
  {lv:16, stage:"read", q:"【説明文】(同じ内容)\n→ 混雑した都市でよく使われる方法は？", c:["屋上庭園と垂直農法", "地下農業", "海上農業", "砂漠農業"], a:0, kw:"説明文", em:"📖", rel:[], exp:"本文の内容から読み取る。"},
