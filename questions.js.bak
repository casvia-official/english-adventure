  {lv:6, stage:"sentence", q:"「これは ペンです」= This ___ a pen.", c:["is", "am", "are", "do"], a:0, kw:"This is", em:"🖊️", rel:[], exp:"This のあとは is。"},
  {lv:6, stage:"sentence", q:"「あれは 鳥です」= That ___ a bird.", c:["is", "are", "am", "do"], a:0, kw:"That is", em:"🐦", rel:[], exp:"That のあとは is。"},
  {lv:6, stage:"sentence", q:"「わたしは 犬が すき」= I ___ dogs.", c:["like", "likes", "am", "liking"], a:0, kw:"I like", em:"🐶", rel:[], exp:"主語 I なので like。"},
  {lv:6, stage:"sentence", q:"「わたしは かばんを もっている」= I ___ a bag.", c:["have", "has", "am", "do"], a:0, kw:"I have", em:"🎒", rel:[], exp:"I のときは have。"},
  {lv:6, stage:"sentence", q:"「わたしは 泳げる」= I ___ swim.", c:["can", "am", "do", "is"], a:0, kw:"I can", em:"🏊", rel:[], exp:"「〜できる」は can+動詞。"},
  {lv:6, stage:"sentence", q:"「彼女は 泳げる」= She ___ swim.", c:["can", "cans", "is", "does"], a:0, kw:"can", em:"🏊", rel:[], exp:"can は主語が変わっても形は同じ。"},
