  {lv:10, stage:"talk", q:"What time do you get up? — ___", c:["At six.","It's six o'clock.","Yes, I do.","On Sunday."], a:0, kw:"時こく", em:"⏰", yaku:"「何時に起きる？」「6時です。」", rel:[], exp:"時こくには At 〜.。"},
